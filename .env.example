# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# The orchestration layer is provider agnostic: any OpenAI-compatible chat
# completions endpoint, an Anthropic messages endpoint, or a locally installed
# OpenCode CLI works.
# Set LLM_PROVIDER to "openai", "anthropic" or "opencode". Default is "openai".

LLM_PROVIDER=openai

# --- OpenAI-compatible (OpenAI, DeepSeek, Kimi, Qwen, OpenRouter, vLLM, ...) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# --- OpenCode (LLM_PROVIDER=opencode) ---------------------------------------
# Delegates every generation call to the local OpenCode CLI, which uses its own
# provider logins and quota - so no API key is needed here.
#
# OpenCode holds the credentials; check what is reachable with `opencode models`
# and log in with `opencode auth login` if the list is empty.
#
# It is invoked as: opencode run [--standalone] --auto --format json
#                   --model <model> --agent <agent>
#
# How it works here: the role's full prompt is written to .task-spec.md inside
# the problem workspace, and the agent is told to read it and then create/edit
# the files itself. So unlike the HTTP backends, the roles do not emit
# <<<FILE ...>>> blocks - the agent writes the workspace directly. Scheduling,
# config merging, preflight checks and verification still belong to this
# pipeline and run after the agent stops.
#
# Two costs worth knowing:
#   * Each call starts a private server with --standalone: roughly 30-45s of
#     overhead before any tokens are spent, and there are five calls per
#     problem. Set OPENCODE_STANDALONE=0 to reuse the background service.
#   * The build agent keeps exploring after it has written its files. It is
#     stopped once the workspace stops changing (see OPENCODE_QUIET_MS), which
#     is what keeps a call from running to the full LLM_TIMEOUT_MS.

# Model id in OpenCode's own provider/model form.
OPENCODE_MODEL=opencode/ling-3.1-flash-free

# Which OpenCode agent to run as. "build" is its normal coding agent and the
# faster path; "plan" is read-only but measured noticeably slower.
OPENCODE_AGENT=build

# Full path to opencode-cli.exe. Leave unset to auto-detect the OpenCode
# Desktop bundle at %LOCALAPPDATA%\Programs\@opencodedesktop\resources\.
# OPENCODE_CLI=

# How long the workspace must stop changing before the agent is considered done
# and stopped early (ms). This is the main lever on wall-clock time.
OPENCODE_QUIET_MS=25000

# 0 reuses OpenCode's background service instead of a private server per call.
OPENCODE_STANDALONE=1

# --- Anthropic (only read when LLM_PROVIDER=anthropic) ---
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=

# Model used for the architect role and the integrator role. These two need the
# strongest reasoning available because they own problem structure and the final
# consistency pass.
LLM_MODEL_ARCHITECT=claude-sonnet-5
# Model used for the three parallel worker roles. Cheaper and faster is fine.
LLM_MODEL_WORKER=claude-sonnet-5

# Hard cap per generation call, in output tokens.
LLM_MAX_OUTPUT_TOKENS=16000
# Request timeout in milliseconds.
LLM_TIMEOUT_MS=600000

# ---------------------------------------------------------------------------
# Filesystem layout
# ---------------------------------------------------------------------------
# Absolute or repo-relative. Defaults to <repo>/problems and <repo>/skills.
# PROBLEMS_DIR=
# SKILLS_DIR=

# ---------------------------------------------------------------------------
# Verification
# ---------------------------------------------------------------------------
# Full path to the verifier from the vendored icpc-problem-creator skill.
VERIFIER_SCRIPT=./skills/icpc-problem-creator/scripts/run-all-tests.ps1
# Set to "0" to skip the PowerShell verification stage after generation.
RUN_VERIFICATION=1