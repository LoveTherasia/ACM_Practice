# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
.next-prod/
out/
next-env.d.ts

# production
build/
dist/

# environment
.env
.env.local
.env*.local

# problem workspaces produced by the pipeline
#
# The leading slash anchors this to the repo root. Without it, the pattern also
# matches src/lib/problems/ - the application's own source directory - which
# silently excluded new files there (format.ts was the first casualty).
/problems/

# leftovers of that tree, in case it is re-included selectively later
/problems/**/testdata/
/problems/**/.testdata/
/problems/**/exported-tests/
.codex-test-artifacts/

# local-model training artifacts (the dataset itself IS tracked)
training/adapter/
training/merged/
training/.venv/

# unsloth compiled-kernel cache (written to the CWD of training runs)
unsloth_compiled_cache/

# OpenCode experiments: scratch workspaces, exported role specs, and the ad-hoc
# probe scripts used to work out how the CLI behaves. These are local tooling,
# not part of the app - and the workspaces contain generated task specs and
# throwaway files that must not reach the repository.
/OpenCode/
/scripts/

# Scratch output from manual OpenCode probes, which write to the CWD.
/data/
/hello.txt

# launcher diagnostics
launcher-debug.log
.devlog.txt
.train.log

# verification transcripts (moved to repo root for easy access)
verify-logs/

# logs
*.log
npm-debug.log*
logs/

# editors / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# typescript
*.tsbuildinfo
